+    assert_eq!(state.head(), Clock::from_events([&a, &y]));
+
+    assert_eq!(state.apply_events(&served, &[&c]).await?, vec![true]);
+    assert_eq!(state.head(), Clock::from_events([&c, &y]));
+    Ok(())
+}
