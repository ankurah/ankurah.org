+        assert!(matches!(result.into_layers(&[&left]).await, Err(MutationError::LineageError(LineageError::Disjoint))));
+    }
+
+    #[tokio::test]
+    async fn exhausted_comparison_returns_its_budget_and_frontiers() {
+        let (mut retriever, history) = linear_history(20);
+        let other = make_test_event_over(40, &[&history[0]]);
+        retriever.add_event(other.clone());
+        let result = compare(retriever, &Clock::singleton(&history[19]), &Clock::singleton(&other), 1).await.unwrap();
+        let AbstractCausalRelation::BudgetExceeded { subject, other } = &result.relation else { panic!("expected budget exhaustion") };
+        let expected_subject = subject.clone();
+        let expected_other = other.clone();
+        assert!(matches!(
+            result.into_layers(&[&history[19]]).await,
+            Err(MutationError::LineageError(LineageError::BudgetExceeded {
+                original_budget: 1, subject_frontier, other_frontier,
+            })) if subject_frontier == expected_subject && other_frontier == expected_other
+        ));
+    }
+
+    #[tokio::test]
+    async fn direct_extension_builds_one_layer_without_reading_either_head_tip() {
+        let root = make_test_event_over(1, &[]);
+        let left = make_test_event_over(2, &[&root]);
+        let right = make_test_event_over(3, &[&root]);
+        let incoming = make_test_event_over(4, &[&left, &right]);
+        let mut events = MockRetriever::new();
+        events.add_event(incoming.clone());
+        let retriever = CountingRetriever::new(events);
+        let result = compare(retriever.clone(), &Clock::singleton(&incoming), &Clock::from_events([&left, &right]), 100).await.unwrap();
+        assert!(matches!(result.relation, AbstractCausalRelation::StrictDescends { .. }));
+        let layers = result.into_layers(&[&incoming]).await.unwrap();
+        let [layer] = layers.layers() else { panic!("expected one layer") };
+        assert!(layer.already_applied.is_empty());
+        assert_eq!(layer.to_apply, vec![incoming.clone()]);
+        assert_eq!(layer.compare(&incoming.id(), &left.id()), CausalRelation::Descends);
+        assert_eq!(layer.compare(&incoming.id(), &right.id()), CausalRelation::Descends);
+        assert_eq!(retriever.reads(), 1, "only the staged incoming event was read");
+    }
+
+    #[tokio::test]
+    async fn empty_head_builds_a_genesis_layer_only_when_application_is_requested() {
+        let genesis = make_test_event_over(1, &[]);
+        let mut events = MockRetriever::new();
+        events.add_event(genesis.clone());
+        let retriever = CountingRetriever::new(events);
+        let result = compare(retriever.clone(), &Clock::singleton(&genesis), &Clock::default(), 100).await.unwrap();
+        assert_eq!(retriever.reads(), 0, "empty-head comparison needs no history");
+        let layers = result.into_layers(&[&genesis]).await.unwrap();
+        let [layer] = layers.layers() else { panic!("expected one layer") };
+        assert!(layer.already_applied.is_empty());
+        assert_eq!(layer.to_apply, vec![genesis]);
+        assert_eq!(retriever.reads(), 1);
+    }
+
+    #[tokio::test]
+    async fn empty_head_cannot_construct_an_update_layer_without_its_history() {
+        let genesis = make_test_event_over(1, &[]);
+        let update = make_test_event_over(2, &[&genesis]);
+        let mut events = MockRetriever::new();
+        events.add_event(update.clone());
+        let result = compare(events, &Clock::singleton(&update), &Clock::default(), 100).await.unwrap();
+        assert!(matches!(result.into_layers(&[&update]).await, Err(MutationError::RetrievalError(RetrievalError::EventNotFound(_)))));
+    }
+}
